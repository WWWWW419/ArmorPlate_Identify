{
  "// 说明": "VS Code + CMake，编译器使用 MinGW-w64 (C:/sdk/mingw64)，构建工具用 MinGW Makefiles",

  "cmake.cmakePath": "C:/sdk/mingw64/bin/cmake.exe",
  "cmake.generator": "MinGW Makefiles",
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.configureOnOpen": true,
  "cmake.configureArgs": [
    "-DCMAKE_C_COMPILER=C:/sdk/mingw64/bin/gcc.exe",
    "-DCMAKE_CXX_COMPILER=C:/sdk/mingw64/bin/g++.exe",
    "-DCMAKE_MAKE_PROGRAM=C:/sdk/mingw64/bin/mingw32-make.exe",
    "-DCMAKE_BUILD_TYPE=Debug"
  ],
  "cmake.environment": {
    "PATH": "C:/sdk/mingw64/bin;${workspaceFolder}/opencv/x64/mingw/bin;${workspaceFolder}/opencv/bin;${env:PATH}"
  },

  "C_Cpp.default.compilerPath": "C:/sdk/mingw64/bin/g++.exe",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",

  "files.encoding": "utf8",
  "files.associations": {
    "*.hpp": "cpp"
  }
}
